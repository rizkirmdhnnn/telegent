# Salin file ini menjadi .env dan isi dengan kredensial Anda
# JANGAN PERNAH commit file .env yang berisi API key atau session ke repositori publik!

# Kredensial Telegram (dapatkan di https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Kredensial Google Gemini (dapatkan di https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# Opsional
TELEGRAM_SESSION_NAME=telegent_session
GEMINI_MODEL=gemini-2.5-flash
