# Salin file ini menjadi .env dan isi dengan kredensial Anda.
# JANGAN PERNAH commit file .env yang berisi API key atau session!

# --- Kredensial Telegram (https://my.telegram.org) ---
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# --- Kredensial Google Gemini (https://aistudio.google.com) ---
GEMINI_API_KEY=AIzaSy...

# --- Sesi Telegram ---
# Nama file sesi (tanpa .session). Harus cocok dengan sesi yang sudah login.
TELEGRAM_SESSION_NAME=userbot_session
# Direktori penyimpanan *.session (set /data saat di Docker).
TELEGRAM_SESSION_DIR=.

# --- Gemini Live ---
GEMINI_MODEL=gemini-3.1-flash-live-preview

# --- Kebijakan akses & beban ---
# Daftar ID Telegram yang diizinkan menelepon (pisah dengan koma). Kosong = semua.
ALLOWED_USER_IDS=
# Jumlah maksimum panggilan bersamaan.
MAX_CONCURRENT_CALLS=4
# Durasi maksimum satu panggilan (detik). 0 = tanpa batas.
MAX_CALL_DURATION=600
# Rate-limit per pengguna: maksimum MAX_CALLS_PER_WINDOW panggilan dalam
# CALL_WINDOW_SECONDS detik. 0 = tanpa batas.
MAX_CALLS_PER_WINDOW=5
CALL_WINDOW_SECONDS=60

# --- Anti-idle (penelpon tidak menjawab) ---
# Bila penelpon diam IDLE_PROMPT_SECONDS detik, AI mengonfirmasi ("masih di sana?").
# Bila tetap tidak ada respons IDLE_HANGUP_SECONDS detik, panggilan diakhiri otomatis.
IDLE_ENABLED=true
IDLE_PROMPT_SECONDS=15
IDLE_HANGUP_SECONDS=15

# --- Logging ---
LOG_LEVEL=INFO

# --- Persona (opsional; ada default di kode) ---
# SYSTEM_INSTRUCTION=
# GREETING_PROMPT=
