# Salin file ini menjadi .env dan isi dengan kredensial Anda.
# JANGAN PERNAH commit file .env yang berisi API key atau session!
#
# CATATAN: file ini hanya dipakai mode bot saja (`telegent --no-web`) dan
# diimpor SEKALI ke database saat panel web pertama kali boot di volume kosong.
# Setelah itu, konfigurasi dikelola dari UI. Lihat docs/web-panel/deployment.md.

# --- Kredensial Telegram (https://my.telegram.org) ---
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# --- Kredensial Google Gemini (https://aistudio.google.com) ---
GEMINI_API_KEY=AIzaSy...

# --- Sesi Telegram ---
# Nama file sesi (tanpa .session). Harus cocok dengan sesi yang sudah login.
TELEGRAM_SESSION_NAME=userbot_session
# Direktori data: lokasi *.session (mode bot saja) dan DB + .secret_key (panel).
# Nama ini juga dipakai image Docker (nilai /data di dalam container).
TELEGENT_DATA_DIR=.

# --- Gemini Live ---
GEMINI_MODEL=gemini-3.1-flash-live-preview

# --- Kebijakan akses & beban ---
# Daftar ID Telegram yang diizinkan menelepon (pisah dengan koma). Kosong = semua.
ALLOWED_USER_IDS=
# Jumlah maksimum panggilan bersamaan.
MAX_CONCURRENT_CALLS=4
# Durasi maksimum satu panggilan (detik). 0 = tanpa batas.
MAX_CALL_DURATION=600
# Rate-limit per pengguna: maksimum MAX_CALLS_PER_WINDOW panggilan dalam
# CALL_WINDOW_SECONDS detik. 0 = tanpa batas.
MAX_CALLS_PER_WINDOW=5
CALL_WINDOW_SECONDS=60

# --- Anti-idle (penelpon tidak menjawab) ---
# Bila penelpon diam IDLE_PROMPT_SECONDS detik, AI mengonfirmasi ("masih di sana?").
# Bila tetap tidak ada respons IDLE_HANGUP_SECONDS detik, panggilan diakhiri otomatis.
IDLE_ENABLED=true
IDLE_PROMPT_SECONDS=15
IDLE_HANGUP_SECONDS=15

# --- Logging ---
LOG_LEVEL=INFO

# --- Web panel (opsional; hanya dibaca mode default) ---
# Diekspos lewat docker compose; tidak perlu diisi di sini kecuali override.
# Panel bind loopback secara default — untuk Docker set 0.0.0.0 di dalam container.
# TELEGENT_HOST=127.0.0.1
# TELEGENT_PORT=8080
# TELEGENT_SESSION_TTL_HOURS=168
# TELEGENT_AUTOSTART_BOT=true
# Kunci enkripsi secret; bila kosong dibuat otomatis di <data_dir>/.secret_key.
# Isi manual hanya bila ingin kunci tetap (mis. saat restore backup).
# TELEGENT_SECRET_KEY=
# Matikan pembacaan berkas .env sepenuhnya (container & pengujian E2E).
# Environment proses tetap dipakai; hanya file .env yang diabaikan.
# TELEGENT_IGNORE_DOTENV=0

# --- Persona (opsional; ada default di kode) ---
# SYSTEM_INSTRUCTION=
# GREETING_PROMPT=
